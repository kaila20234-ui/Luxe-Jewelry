{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "siwes_project",
  "version": "1.0.0",
  "description": "A jewelry e-commerce project with Paystack payment integration and MongoDB backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:authService": "jest tests/authService.test.js",
    "test:paymentService": "jest tests/paymentService.test.js",
    "test:errorHandler": "jest tests/errorHandler.test.js"
  },
  "nodemonConfig": {
    "ignore": [
      "luxe_customer_app/**"
    ]
  },
  "keywords": [
    "ecommerce",
    "paystack",
    "express",
    "jewelry",
    "mongodb",
    "nodejs"
  ],
  "author": "Hafizu Kaila",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.2.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "parse5": "^7.1.1",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "speakeasy": "^2.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}

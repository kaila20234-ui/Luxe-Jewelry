# ---------------------------
# 🌐 SERVER CONFIGURATION
# ---------------------------
PORT=5000

# ---------------------------
# 🗄️ DATABASE CONFIGURATION
# ---------------------------
# MongoDB connection string - update with your actual database
MONGO_URI=mongodb://127.0.0.1:27017/luxe_jewelry

# ---------------------------
# 💳 PAYSTACK CONFIGURATION
# ---------------------------
# Get these from https://dashboard.paystack.com/#/settings/developer
# IMPORTANT: Use LIVE keys in production, not test keys
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_INITIALIZE_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify/
CURRENCY=NGN

# ---------------------------
# 📧 EMAIL CONFIGURATION
# ---------------------------
# Using Gmail? Create an App Password: https://myaccount.google.com/apppasswords
# Do NOT use your main Gmail password - use app-specific password
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# ---------------------------
# 👤 ADMIN CONFIGURATION
# ---------------------------
# Manager account
ADMIN_USER=manager
# Hash this password using: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASS_HASH=$2b$10$YOUR_HASHED_PASSWORD_HERE

# Super Admin account (site admin)
SITE_ADMIN_USER=admin
SITE_ADMIN_PASS=your_secure_admin_password

# ---------------------------
# 🔐 SECURITY CONFIGURATION
# ---------------------------
# CRITICAL: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters, cryptographically random
JWT_SECRET=your_32_character_random_secret_key_here

# ---------------------------
# 💾 REDIS CACHE CONFIGURATION
# ---------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTLs (in seconds)
CACHE_PRODUCT_LIST=300
CACHE_PRODUCT_DETAIL=600
CACHE_SEARCH=300
CACHE_SESSION=86400
CACHE_CATEGORY=600
CACHE_REVIEWS=300

# Cache enabled/disabled
CACHE_ENABLED=true
CACHE_WARM_ON_START=false

# Session cache
SESSION_CACHE_TTL=86400
SESSION_REFRESH_ENABLED=true

# ---------------------------
# 📊 PERFORMANCE & MONITORING
# ---------------------------

# Performance Monitor
MONITOR_ENABLED=true
MONITOR_SLOW_THRESHOLD_MS=500
MONITOR_COLLECT_INTERVAL_MS=60000
MONITOR_HISTORY_WINDOW_MS=3600000

# Cache Optimizer
CACHE_OPTIMIZER_ENABLED=true
CACHE_WARM_ON_START=true
CACHE_OPTIMIZATION_CHECK_INTERVAL=300000
CACHE_MAX_TTL=3600
CACHE_MIN_TTL=300

# Performance Baseline
PERF_CAPTURE_BASELINE=true
PERF_BASELINE_DURATION_SECONDS=3600

# ---------------------------
# 🐳 DOCKER & DEPLOYMENT
# ---------------------------

# Application
NODE_ENV=development
DEBUG=false

# Docker services
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=luxejewelry
DOCKER_VERSION=latest

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password

# Production flags
PRODUCTION_READY=true
ENABLE_MONITORING_DASHBOARD=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_ANALYTICS=true
